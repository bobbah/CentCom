@page "/"

@using CentCom.API.Models
@using CentCom.API.Services
@using CentCom.Common.Models.DTO
@inject IBanService BanService
@inject NavigationManager Navigation

<PageTitle>CentCom - Ban Viewer</PageTitle>

<div class="home-page">
    <MudPaper Class="hero pa-4" Outlined Elevation="0">
        <MudText Typo="Typo.overline" Class="hero-kicker">Centralized Moderation Viewer</MudText>
        <MudText Typo="Typo.h3" Class="hero-title">See Ban Activity Across Every Source</MudText>
        <MudText Typo="Typo.body1" Class="hero-subtitle">
            Track totals by server, monitor the newest actions in real-time style, and jump straight to a player's ban history from the global search.
        </MudText>

        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/swagger" Target="_blank"
                       StartIcon="@Icons.Material.Filled.Code">API Documentation</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/bans" StartIcon="@Icons.Material.Filled.Search">
                Search by CKey
            </MudButton>
        </MudStack>
    </MudPaper>

    <MudGrid Spacing="4" Class="panel-grid mt-0">
        <MudItem xs="12" md="6">
            <MudPaper Class="panel pa-4" Outlined Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.h5">Bans by Source</MudText>
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">Total @_sourceTotals.Sum(x => x.TotalBans)</MudChip>
                </MudStack>

                @if (_isLoading)
                {
                    <MudSkeleton Height="46px" Class="mt-3"/>
                    <MudSkeleton Height="46px" Class="mt-2"/>
                    <MudSkeleton Height="46px" Class="mt-2"/>
                }
                else if (_sourceTotals.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                        No source data was found.
                    </MudAlert>
                }
                else
                {
                    <MudTable Dense="true"
                              Hover="true"
                              Striped="true"
                              Bordered="false"
                              FixedHeader="true"
                              Height="420px"
                              Breakpoint="Breakpoint.None"
                              Items="_sourceTotals"
                              Class="mt-3 source-table">
                        <HeaderContent>
                            <MudTh>Server</MudTh>
                            <MudTh Class="text-right">Total Bans</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Server">@context.SourceName</MudTd>
                            <MudTd DataLabel="Total" Class="text-right">@context.TotalBans</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="panel pa-4" Outlined Elevation="0">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.h5">Latest Bans</MudText>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Text">Rolling feed</MudChip>
                </MudStack>

                @if (_isLoading)
                {
                    <MudSkeleton Height="52px" Class="mt-3"/>
                    <MudSkeleton Height="52px" Class="mt-2"/>
                    <MudSkeleton Height="52px" Class="mt-2"/>
                    <MudSkeleton Height="52px" Class="mt-2"/>
                }
                else if (_latestBans.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                        No recent bans were found.
                    </MudAlert>
                }
                else
                {
                    <div class="rolling-wrap mt-3">
                        <div class="rolling-track">
                            @foreach (var ban in _latestBans)
                            {
                                <button type="button" class="latest-row" @onclick="() => GoToCkey(ban.CKey)">
                                    <span class="latest-ckey">@ban.CKey</span>
                                    <span class="latest-source">@ban.SourceName</span>
                                    <span class="latest-time"><LocalTime Time="@ban.BannedOn" /></span>
                                </button>
                            }

                            @foreach (var ban in _latestBans)
                            {
                                <button type="button" class="latest-row" @onclick="() => GoToCkey(ban.CKey)">
                                    <span class="latest-ckey">@ban.CKey</span>
                                    <span class="latest-source">@ban.SourceName</span>
                                    <span class="latest-time"><LocalTime Time="@ban.BannedOn" /></span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</div>

@code {
    private readonly List<BanSourceTotalData> _sourceTotals = [];
    private readonly List<BanData> _latestBans = [];
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;

        var totals = await BanService.GetBanTotalsBySourceAsync();
        var latest = await BanService.GetLatestBansAsync(16);

        _sourceTotals.Clear();
        _sourceTotals.AddRange(totals);

        _latestBans.Clear();
        _latestBans.AddRange(latest);

        _isLoading = false;
    }

    private void GoToCkey(string ckey)
    {
        Navigation.NavigateTo($"/bans/{Uri.EscapeDataString(ckey)}");
    }
}
